@OrganizaAtividades_HostAddress = https://localhost:7226
@token = COLE_AQUI_O_TOKEN_RETORNADO_PELO_LOGIN

POST {{OrganizaAtividades_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@organiza.com",
  "senha": "Admin@123"
}

###

POST {{OrganizaAtividades_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "usuario@organiza.com",
  "senha": "Usuario@123"
}

###

GET {{OrganizaAtividades_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}
Accept: application/json

###

